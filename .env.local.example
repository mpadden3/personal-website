# OpenRouter — server-side AI calls (Mariners Pulse narrative)
OPENROUTER_API_KEY=

# Public site URL — used as HTTP-Referer on OpenRouter requests
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron — Vercel sends "Authorization: Bearer ${CRON_SECRET}" automatically
# when this env var is set in the project. Generate with: openssl rand -hex 32
CRON_SECRET=

# Vercel Blob — read/write token from the Vercel dashboard after enabling Blob
BLOB_READ_WRITE_TOKEN=

# Public URL of the Savant rolling JSON blob (set after first put())
# Example: https://<store-id>.public.blob.vercel-storage.com/mariners-pulse/savant-rolling.json
SAVANT_BLOB_URL=

# EXA — web search for the wedding planner assistant + AI Use Case Scorer
EXA_API_KEY=

# OpenAI — image generation (wireframe sketches) + content moderation for AI Use Case Scorer
OPENAI_API_KEY=

# Optional: public URL of the wedding checklist blob (auto-discovered via list() if unset)
# Example: https://<store-id>.public.blob.vercel-storage.com/wedding/checklist-state.json
WEDDING_BLOB_URL=

# Optional: public URL of the Mariners Pulse narrative blob (auto-discovered via list() if unset)
# Example: https://<store-id>.public.blob.vercel-storage.com/mariners-pulse/narrative.json
NARRATIVE_BLOB_URL=
